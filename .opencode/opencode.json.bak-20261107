{
  "$schema": "https://opencode.ai/config.json",

  "model": "openrouter/openai/gpt-6.1-terra",
  "default_agent": "assistant",
    "providers": {
    "lmstudio": {
      "settings": {
        "baseURL": "http://127.0.0.1:1235/v1",
        "headerTimeout": 180000,
        "chunkTimeout": 180000
      },
      "models": {
        "google/gemma-4-12b-qat": {
          "name": "Gemma 4 12B QAT (local)",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": { "context": 262144, "output": 4096 },
          "body": { "temperature": 0.2, "top_p": 0.9 }
        },
      "qwen/qwen3.8-27b": {
        "name": "Qwen3.8 27B (local)",
        "capabilities": {
          "tools": true,
          "input": ["text"],
          "output": ["text"]
        },
        "limit": { "context": 32768, "output": 4096 },
        "body": { "temperature": 0.6, "top_p": 0.95, "top_k": 20 }
        },
        "gemma-4-26b-a4b-it-qat": {
          "name": "Gemma 4 26B A4B QAT (local)",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": { "context": 262144, "output": 4096 },
          "body": { "temperature": 1, "top_p": 0.95, "top_k": 64 }
        }
      }
    }
  },

  "websearch": {
    "provider": "exa"
  },

  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
    { "action": "shell", "resource": "Remove-Item * -Recurse *", "effect": "ask" }
  ],

  "compaction": {
    "auto": true,
    "keep": { "tokens": 20000 },
    "buffer": "12%"
  },

  "tool_output": {
    "max_lines": 1200,
    "max_bytes": 48000
  },

  "media": {
    "image": {
      "auto_resize": true,
      "max_width": 1600,
      "max_height": 1600,
      "max_base64_bytes": 2097152
    }
  },

  "experimental": {
    "todo": true,
    "subagent_depth": 1,
    "background_compaction": true
  },

  "watcher": {
    "ignore": [
      "data/**",
      "models/**",
      ".venv/**",
      "__pycache__/**",
      "*.wav",
      "*.mp3",
      "*.flac",
      "*.mp4",
      "*.mkv",
      "*.onnx",
      "*.bin",
      "*.pt",
      "*.ckpt"
    ]
  },

  "mcp": {
    "timeout": {
      "startup": 45000,
      "catalog": 30000,
      "execution": 600000
    },
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,agent_run,web_search_advanced_exa",
        "headers": {
          "x-api-key": "{env:EXA_API_KEY}"
        }
      }
    }
  }
}

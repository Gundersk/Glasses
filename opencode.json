{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-terra",
  "compaction": {
    "auto": true,
    "keep": { "tokens": 24000 },
    "buffer": "20%"
  },
  "warming": false,
  "experimental": { "background_compaction": false },
  "providers": {
    "openai": {
      "settings": { "compaction": { "type": "summary" } },
      "models": {
        "gpt-6.1-terra": {
          "settings": { "reasoningEffort": "medium" },
          "variants": [
            { "id": "autonomy", "settings": { "reasoningEffort": "medium" }, "body": { "max_output_tokens": 12000 } }
          ]
        },
        "gpt-6.1-sol": {
          "variants": [
            { "id": "autonomy-audit", "settings": { "reasoningEffort": "high" }, "body": { "max_output_tokens": 24000 } }
          ]
        }
      }
    },
    "openrouter": {
      "models": {
        "deepseek/deepseek-v4.1-flash-1017": {
          "variants": [
            {
              "id": "compact",
              "body": {
                "temperature": 0,
                "reasoning": { "effort": "none" }
              }
            },
            {
              "id": "nothink",
              "body": {
                "reasoning": { "effort": "none" }
              }
            }
          ]
        }
      }
    }
  },
  "agents": {
    "mentor": {
      "model": "kimi-code-plan-global/k3.1-pro#high"
    },
    "reviewer": {
      "model": "openai/gpt-6.1-sol#autonomy-audit"
    },
    "assistant": {
      "model": "openrouter/deepseek/deepseek-v4.1-flash-1017#nothink"
    },
    "implementer": {
      "model": "openai/gpt-6.1-terra#autonomy"
    },
    "researcher": {
      "model": "openrouter/deepseek/deepseek-v4.1-flash-1017#high"
    },
    "digester": {
      "model": "openrouter/z-ai/glm-5.3-flash#low"
    },
    "explainer": {
      "model": "openrouter/deepseek/deepseek-v4.1-flash-1017#low"
    },
    "general": {
      "model": "openrouter/deepseek/deepseek-v4.1-flash-1017#low"
    },
    "explore": {
      "model": "openrouter/deepseek/deepseek-v4.1-flash-1017#nothink"
    }
  }
}

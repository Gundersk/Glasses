# Ключи для автономной системы (autonomy/). Реальные значения — в .env (не коммитить).
# Секреты берутся только из переменных окружения (правило проекта №9).

OPENROUTER_API_KEY=            # ladder: qwen3.8-flash, glm-5.3-flash, deepseek-1017
GEMINI_API_KEY=                # бесплатный Gemini 3.6 Flash (AI Studio), аккаунт 1
GEMINI_API_KEY_ALT=            # второй бесплатный аккаунт Google, отдельная квота
KIMI_API_KEY=                  # эскалация / ментор
TINYFISH_API_KEY=              # поиск/чтение страниц для проверки фактов
EXA_API_KEY=                   # семантический поиск (researcher)
EXA_API_KEY_ALT=
EXA_API_KEY_QWEN=
CONTEXT7_API_KEY=              # документация библиотек

# Локальная модель (Strata, OpenAI-совместимый сервер, только localhost)
# Browser-session auxiliary gateway; no cookies or credentials in git.
CHAT2API_BASE_URL=http://127.0.0.1:8080/v1
CHAT2API_KEY=

LOCAL_LLM_BASE_URL=http://127.0.0.1:18500/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=swift-1.5-iq3_xxs
